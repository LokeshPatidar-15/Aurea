APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BINANCE_BASE_URL=https://api.binance.com/api/v3
REQUEST_TIMEOUT_SECONDS=5

DATABASE_URL=postgresql://user:password@localhost:5433/aurea
JWT_SECRET=change-me
LLM_API_KEY=your-key-here
BROKER_API_KEY=your-key-here
BROKER_API_SECRET=your-secret-here
WS_POLL_SECONDS=5
WS_MAX_CLIENTS=100
WS_FEED_ENABLED=true
WS_IDLE_GRACE_SECONDS=60
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
